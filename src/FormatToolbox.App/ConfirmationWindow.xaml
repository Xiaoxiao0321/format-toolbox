<Window x:Class="FormatToolbox.App.ConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="520" Height="300" MinWidth="300" MinHeight="180" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="16">
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="ConfirmButton" Content="确定" IsDefault="True" MinWidth="85" Click="Confirm_Click" Padding="12,5" Margin="3"/>
      <Button x:Name="CancelButton" Content="取消" IsCancel="True" MinWidth="85" Padding="12,5" Margin="3"/>
    </WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"/></ScrollViewer>
  </DockPanel>
</Window>
