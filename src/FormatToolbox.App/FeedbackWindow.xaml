<Window x:Class="FormatToolbox.App.FeedbackWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FormatToolbox.App" Title="意见反馈与客服" Width="880" Height="740" MinWidth="760" MinHeight="620" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="意见反馈与客服" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="遇到问题或有改进建议？提交反馈便于开发者统一跟进，也可以使用微信联系。" Margin="0,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Foreground="#36566F" TextWrapping="Wrap"/>
      <Button Content="关闭" IsCancel="True" HorizontalAlignment="Right" Width="90" Click="Close_Click"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel>
          <GroupBox Header="微信客服" Padding="8" Margin="0,0,12,0">
            <StackPanel>
              <Image Source="Assets/support-wechat.jpg" Width="280" Height="235" Stretch="Uniform"/>
              <TextBlock Text="使用微信扫一扫，联系开发者 / 客服" HorizontalAlignment="Center" Margin="0,8,0,0"/>
              <TextBlock Text="客服二维码由开发者提供，随程序内置；显示二维码无需联网。" Foreground="Gray" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="提交问题或建议" Padding="10" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="反馈网页" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="请描述你想完成什么、进行了哪些操作，以及实际结果。可附截图，请遮挡隐私信息。" TextWrapping="Wrap" Margin="0,7,0,10"/>
              <TextBox Text="{x:Static local:FeedbackWindow.FeedbackUrl}" IsReadOnly="True" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,7,0,0">
                <Button Content="打开反馈网页（需联网）" Click="OpenWebsite_Click"/>
                <Button Content="复制网址" Click="CopyUrl_Click"/>
              </WrapPanel>
              <Border Background="#F3F6FA" Padding="9" Margin="0,10,0,0">
                <TextBlock Text="网页将在系统默认浏览器中打开。应用不会附加环境信息、文件或日志；你填写的内容将由网页服务接收。" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </GroupBox>
        </StackPanel>
        <GroupBox Header="可选：本机环境信息（仅本地检测，可预览后复制）" Padding="10" Margin="0,12,0,0">
          <StackPanel>
            <TextBox x:Name="EnvironmentText" Text="正在检测本机转换引擎…" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <WrapPanel>
              <Button x:Name="CopyEnvironmentButton" Content="复制环境信息" IsEnabled="False" Click="CopyEnvironment_Click"/>
              <Button Content="复制诊断信息" Click="CopyDiagnostics_Click"/><Button Content="打开本地诊断日志目录" Click="OpenLogs_Click"/>
            </WrapPanel>
            <TextBlock Text="日志可能包含文件路径或错误详情。请检查并删除敏感内容后自行发送；不要提交机密文档或唯一副本。" Foreground="#8A5700" TextWrapping="Wrap" Margin="3,5,3,0"/>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
