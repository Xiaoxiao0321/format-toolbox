<Window x:Class="FormatToolbox.App.PdfToolsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDF 页面整理与拆分" Width="980" Height="680" MinWidth="760" MinHeight="520">
  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,5"/>
    <StackPanel DockPanel.Dock="Top">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="PDF 文件：" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding InputPath}" IsReadOnly="True"/><Button Grid.Column="2" Content="选择…" Click="ChoosePdf_Click"/></Grid>
      <WrapPanel Margin="0,6">
        <StackPanel Orientation="Horizontal"><TextBlock Text="拆分方式：" VerticalAlignment="Center"/><ComboBox Width="150" ItemsSource="{Binding SplitModes}" SelectedItem="{Binding SelectedSplitMode}"/></StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="参数：" VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding SplitParameter}" ToolTip="指定范围用分号分组，如 1-3;4-6；每 N 页填写数字"/></StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="输出名称：" VerticalAlignment="Center"/><TextBox Width="150" Text="{Binding OutputBaseName}"/></StackPanel>
        <Button Content="保存页面整理" Click="SaveReordered_Click" IsEnabled="{Binding PreviewReady}"/><Button Content="加入拆分队列" Click="Split_Click"/>
      </WrapPanel>
    </StackPanel>
    <DockPanel><StackPanel DockPanel.Dock="Right" Width="110"><Button Content="上移" Click="MoveUp_Click"/><Button Content="下移" Click="MoveDown_Click"/><Button Content="全选保留" Click="KeepAll_Click"/><Button Content="反选" Click="Invert_Click"/></StackPanel>
      <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectionMode="Single" AllowDrop="True" PreviewMouseMove="PageList_MouseMove" Drop="PageList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#BBB" BorderThickness="1" Margin="5" Padding="5"><StackPanel Width="180"><Image Source="{Binding Thumbnail}" Height="210" Stretch="Uniform"/><CheckBox Content="{Binding Label}" IsChecked="{Binding Keep}" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </DockPanel>
</Window>
