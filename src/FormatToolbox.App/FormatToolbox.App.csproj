<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>格式转换工具箱</AssemblyName><Product>格式转换工具箱</Product>
    <Version>1.0.8</Version><AssemblyVersion>1.0.8.0</AssemblyVersion><FileVersion>1.0.8.0</FileVersion>
    <Authors>FormatToolbox Contributors</Authors><Copyright>Copyright © 2026</Copyright>
    <ApplicationIcon>app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FormatToolbox.Core\FormatToolbox.Core.csproj" />
    <ProjectReference Include="..\FormatToolbox.Infrastructure\FormatToolbox.Infrastructure.csproj" />
    <ProjectReference Include="..\FormatToolbox.Worker\FormatToolbox.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\support-wechat.jpg" />
    <Resource Include="app-icon.png" />
    <Content Include="THIRD-PARTY-NOTICES.txt"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="licenses\**\*"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
  <Target Name="CopyConversionWorker" AfterTargets="Build">
    <ItemGroup><WorkerFiles Include="..\FormatToolbox.Worker\bin\$(Configuration)\$(TargetFramework)\FormatToolbox.Worker.*" /></ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
