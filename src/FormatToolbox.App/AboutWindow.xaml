<Window x:Class="FormatToolbox.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="关于格式转换工具箱" Width="680" Height="520" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner">
  <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="app-icon.png" Width="64" Height="64" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="格式转换工具箱" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Margin="0,4,0,0"/></StackPanel></StackPanel>
    <Border Grid.Row="1" Background="#F3F6FA" Padding="10" Margin="0,14,0,10"><StackPanel><TextBlock Text="全部转换均在本机完成，不上传用户文件。"/><TextBlock x:Name="RuntimeText" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    <TextBox Grid.Row="2" x:Name="NoticesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="打开声明文件" Click="OpenNotices_Click"/><Button Content="查看完整许可文本" Click="OpenLicenses_Click"/><Button Content="关闭" IsDefault="True" Click="Close_Click"/></WrapPanel>
  </Grid>
</Window>
